# Copie ce fichier en .env et complète-le.
#
#     cp .env.example .env
#
# .env est exclu par .gitignore et ne doit jamais être commité : un secret
# poussé sur un dépôt distant est compromis même après suppression, puisque
# l'historique Git le conserve.


# --- Moteur -------------------------------------------------------------
# Chemin du binaire Stockfish. Laisse vide pour la détection automatique, qui
# couvre /usr/games/stockfish (Debian, Ubuntu, Kali), /usr/local/bin et
# Homebrew. Vérifie avec : which stockfish
STOCKFISH_PATH=/usr/games/stockfish


# --- Base de données ----------------------------------------------------
# Optionnelle. Sans elle l'application fonctionne, mais n'enregistre ni les
# parties ni les analyses : chaque ouverture relance un calcul complet.
#
# Création côté serveur :
#   CREATE DATABASE chess_review CHARACTER SET utf8mb4
#          COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'chess'@'localhost' IDENTIFIED BY 'un-mot-de-passe-solide';
#   GRANT ALL PRIVILEGES ON chess_review.* TO 'chess'@'localhost';
#
# Ces variables priment sur les champs de Réglages → Base de données, qui
# apparaissent alors grisés : une seule source de vérité.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chess_review
DB_USER=
DB_PASSWORD=


# --- Emplacement des ressources -----------------------------------------
# À ne renseigner que pour une installation hors du dossier du projet. Par
# défaut tout est résolu depuis la racine du dépôt, quel que soit le
# répertoire depuis lequel la commande est lancée.
#CHESS_REVIEW_OPENINGS=~/.local/share/chess-review/openings
#CHESS_REVIEW_SOUNDS=~/.local/share/chess-review/sounds
#CHESS_REVIEW_PIECES=~/.local/share/chess-review/pieces
#CHESS_REVIEW_BADGES=~/.local/share/chess-review/badges
#CHESS_REVIEW_ASSETS=~/.local/share/chess-review
#CHESS_REVIEW_GAMES=~/.local/share/chess-review/games
#CHESS_REVIEW_ENV=~/.config/chess-review/.env
